# BasicEmployerFlow

main: kit: flow: BasicEmployerFlow:
{
  entity: "employer",
  kind: "basic",
  name: "BasicEmployerFlow",
  step: [
    {
      i: {
        ref: "employer_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "employer_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "employer_ref01",
        srcdatavar: "employer_ref01_data",
        suffix: "_up0",
        textfield: "legal_name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-employer_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "employer_ref01",
        srcdatavar: "employer_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "employer01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-employer_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEmployerFlow"
}