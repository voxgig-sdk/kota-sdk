# BasicPlanFlow

main: kit: flow: BasicPlanFlow:
{
  entity: "plan",
  kind: "basic",
  name: "BasicPlanFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "plan_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "plan_ref01",
        srcdatavar: "plan_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "plan01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-plan_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPlanFlow"
}