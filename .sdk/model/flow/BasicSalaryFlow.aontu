# BasicSalaryFlow

main: kit: flow: BasicSalaryFlow:
{
  entity: "salary",
  kind: "basic",
  name: "BasicSalaryFlow",
  step: [
    {
      i: {
        ref: "salary_ref01"
      }

      m: {
        employee_id: "employee01"
      }

      o: "create"
    }

    {
      m: {
        employee_id: "employee01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "salary_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "salary_ref01",
        srcdatavar: "salary_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "salary01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-salary_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "salary_ref01",
        suffix: "_rm0"
      }

      m: {
        employee_id: "employee01",
        id: "salary01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        employee_id: "employee01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "salary_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSalaryFlow"
}