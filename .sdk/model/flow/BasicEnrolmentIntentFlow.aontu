# BasicEnrolmentIntentFlow

main: kit: flow: BasicEnrolmentIntentFlow:
{
  entity: "enrolment_intent",
  kind: "basic",
  name: "BasicEnrolmentIntentFlow",
  step: [
    {
      i: {
        ref: "enrolment_intent_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "enrolment_intent_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "enrolment_intent_ref01",
        srcdatavar: "enrolment_intent_ref01_data",
        suffix: "_up0",
        textfield: "employee_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-enrolment_intent_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "enrolment_intent_ref01",
        srcdatavar: "enrolment_intent_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "enrolment_intent01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-enrolment_intent_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEnrolmentIntentFlow"
}