# BasicGroupPolicyIntentFlow

main: kit: flow: BasicGroupPolicyIntentFlow:
{
  entity: "group_policy_intent",
  kind: "basic",
  name: "BasicGroupPolicyIntentFlow",
  step: [
    {
      input: {
        ref: "group_policy_intent_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "group_policy_intent_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "group_policy_intent_ref01",
        srcdatavar: "group_policy_intent_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "group_policy_intent01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-group_policy_intent_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGroupPolicyIntentFlow"
}