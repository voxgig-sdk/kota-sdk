# BasicProviderFlow

main: kit: flow: BasicProviderFlow:
{
  entity: "provider",
  kind: "basic",
  name: "BasicProviderFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "provider_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "provider_ref01",
        srcdatavar: "provider_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "provider01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-provider_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProviderFlow"
}