                t: "`$STRING`"
              }
              {
                k: "query"
                n: "type"
                or: "type"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/plans"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "plans"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.items`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /plans/{plan_id}"
