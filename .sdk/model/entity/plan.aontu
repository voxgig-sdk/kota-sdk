# Entity: plan

main: kit: entity: plan: {

  alias: field: {}

  fields: {
    available_from: {
      fo: "date"
      h: "Available From"
      n: "available_from"
      r: true
      sh: "The date from which this plan is available (inclusive)."
      t: "`$STRING`"
    }
    available_to: {
      fo: "date"
      h: "Available To"
      n: "available_to"
      r: false
      sh: "The date until which this plan is available (inclusive)."
      t: [
        "`$ONE`"
        [
          "`$NULL`"
          "`$STRING`"
        ]
      ]
    }
    country: {
      h: "Country"
      n: "country"
      r: true
      sh: "The country this plan is available in."
      t: "`$STRING`"
    }
    coverage_options: {
      h: "Coverage Options"
      n: "coverage_options"
      r: false
      sh: "Coverage options available for this plan, organized by scope and input type."
      t: [
        "`$ONE`"
        [
          "`$NULL`"
          "`$ARRAY`"
        ]
      ]
    }
    description: {
      h: "Description"
      n: "description"
      r: true
      sh: "Description of the plan."
      t: "`$STRING`"
    }
    disclosures: {
      h: "Disclosures"
      n: "disclosures"
