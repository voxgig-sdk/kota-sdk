      sh: "Disclosures associated with this plan."
      t: "`$ARRAY`"
    }
    documents: {
      h: "Documents"
      n: "documents"
      r: true
      sh: "List of plan documents (e.g., IPIDs, T&Cs)."
      t: "`$ARRAY`"
    }
    eligible_count: {
      fo: "int32"
      h: "Eligible Count"
      n: "eligible_count"
      r: false
      sh: "Number of employees in the queried group eligible for this plan as-of `start_date`."
      t: [
        "`$ONE`"
        [
          "`$NULL`"
          "`$INTEGER`"
        ]
      ]
    }
    employee_eligibility_criteria: {
      h: "Employee Eligibility Criteria"
      n: "employee_eligibility_criteria"
      r: true
      sh: "Eligibility criteria that employees must meet."
      t: "`$ARRAY`"
    }
    employer_eligibility_criteria: {
      h: "Employer Eligibility Criteria"
      n: "employer_eligibility_criteria"
      r: true
      sh: "Eligibility criteria that employers must meet."
      t: "`$ARRAY`"
    }
    health_insurance: {
      h: "Health Insurance"
      n: "health_insurance"
      r: false
      sh: "Health insurance-specific details."
      t: "`$NULL`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the plan."
      t: "`$STRING`"
    }
    ineligible_count: {
      fo: "int32"
      h: "Ineligible Count"
      n: "ineligible_count"
      r: false
      sh: "Number of employees in the queried group ineligible for this plan as-of `start_date`."
      t: [
        "`$ONE`"
        [
          "`$NULL`"
          "`$INTEGER`"
        ]
      ]
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the plan."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: false
      ro: true
      sh: "Object type."
      t: "`$STRING`"
    }
    provider: {
      h: "Provider"
      n: "provider"
      r: true
      sh: "The provider offering this plan."
      t: "`$ANY`"
    }
    total_count: {
      fo: "int32"
      h: "Total Count"
      n: "total_count"
      r: false
      sh: "Total employees in the queried group."
      t: [
        "`$ONE`"
        [
          "`$NULL`"
          "`$INTEGER`"
        ]
      ]
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "The benefit type of the plan."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "plan"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
