# Entity: create_hosted_session_token

main: kit: entity: create_hosted_session_token: {

  alias: field: {}

  fields: [
    {
      format: "date-time"
      name: "expiry"
      req: true
      type: "`$STRING`"
    }
    {
      name: "link"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "create_hosted_session_token"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/hosted/sessions"
          segments: [
            {
              lit: "hosted"
            }
            {
              lit: "sessions"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
