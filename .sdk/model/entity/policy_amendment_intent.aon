            id: "POST /policies/{policy_id}/policy_amendment_intents"
            json: "{\"operationId\":\"CreatePolicyAmendmentIntent\",\"parameters\":[{\"in\":\"path\",\"name\":\"policy_id\",\"required\":true,\"schema\":{\"example\":\"p_3b1333d87d9d4fd6ad83ba7f6b0e951a\",\"pattern\":\"p_.+\",\"type\":\"string\"}},{\"description\":\"The target platform id. Required only when calling with a dashboard (WorkOS AuthKit) access token instead of a platform API key — the token carries no platform claim, so the caller must say which platform it means. Ignored for platform API key / embed session token callers.\",\"in\":\"header\",\"name\":\"X-Platform-Id\",\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"amendment_reason\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"qualifying_life_event\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"event\":{\"allOf\":[{\"enum\":[\"gained_other_insurance_coverage\",\"divorce_or_legal_separation\",\"death_of_spouse_or_dependent\",\"moved_out_of_coverage_area\",\"employment_status_change_affecting_eligibility\",\"eligible_for_government_program\",\"marriage_or_civil_partnership\",\"birth_of_child\",\"adoption_of_child\",\"gained_legal_guardianship\",\"dependent_lost_other_coverage\",\"lost_legal_guardianship\",\"dependent_gained_other_coverage\",\"dependent_eligible_for_government_program\",\"dependent_aged_out\",\"dependent_student_status_change_affecting_eligibility\",\"dependent_moved_in_or_out_of_coverage_area\",\"other_change\"],\"type\":\"string\"}],\"description\":\"The type of qualifying life event requested.\"},\"event_date\":{\"description\":\"The date at which the event occured. Note: This date must be within provider guidelines, where the date is outside of those guidelines the amendment may be rejected or the effective date of the change could be amended by the provider.\",\"example\":\"2024-12-01\",\"format\":\"date\",\"type\":\"string\"},\"reason\":{\"description\":\"A free text reason of the qualifying life event. Note: This will be shared with the insurance provider in lieu of `event` when its set to `other_change`.\",\"type\":[\"null\",\"string\"]}},\"required\":[\"event\",\"event_date\"],\"type\":\"object\"}],\"description\":\"Supplemental information required for qualifying life event amendments.\",\"type\":\"null\"},\"type\":{\"allOf\":[{\"enum\":[\"initial_adjustment_period\",\"qualifying_life_event\"],\"type\":\"string\"}],\"description\":\"The type of amendment reason.\"}},\"required\":[\"type\"],\"type\":\"object\"}],\"description\":\"The reason for the policy amendment.\"},\"requested_changes\":{\"description\":\"List of requested changes to the policy.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"change_type\":{\"allOf\":[{\"enum\":[\"dependents\",\"cancellation\"],\"type\":\"string\"}],\"description\":\"The type of change requested.\"}},\"required\":[\"change_type\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"amendment_reason\",\"requested_changes\"],\"type\":\"object\"}]}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"amendment_reason\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"qualifying_life_event\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"event\":{\"allOf\":[{\"enum\":[\"gained_other_insurance_coverage\",\"divorce_or_legal_separation\",\"death_of_spouse_or_dependent\",\"moved_out_of_coverage_area\",\"employment_status_change_affecting_eligibility\",\"eligible_for_government_program\",\"marriage_or_civil_partnership\",\"birth_of_child\",\"adoption_of_child\",\"gained_legal_guardianship\",\"dependent_lost_other_coverage\",\"lost_legal_guardianship\",\"dependent_gained_other_coverage\",\"dependent_eligible_for_government_program\",\"dependent_aged_out\",\"dependent_student_status_change_affecting_eligibility\",\"dependent_moved_in_or_out_of_coverage_area\",\"other_change\"],\"type\":\"string\"}],\"description\":\"The type of qualifying life event.\"},\"event_date\":{\"description\":\"The date when the qualifying life event occurred.\",\"example\":\"2024-12-01\",\"format\":\"date\",\"type\":\"string\"},\"reason\":{\"description\":\"Additional reason or description for the qualifying life event.\",\"type\":[\"null\",\"string\"]}},\"required\":[\"event\",\"event_date\"],\"type\":\"object\"}],\"description\":\"Details when `type` is `qualifying_life_event`.\",\"type\":\"null\"},\"type\":{\"allOf\":[{\"enum\":[\"initial_adjustment_period\",\"qualifying_life_event\"],\"type\":\"string\"}],\"description\":\"Unique identifier of the amendment reason type.\"}},\"required\":[\"type\"],\"type\":\"object\"}],\"description\":\"The reason for the policy amendment.\"},\"disclosures\":{\"description\":\"Disclosures associated with this intent.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"category\":{\"allOf\":[{\"enum\":[\"regulatory\",\"provider\",\"intermediary\"],\"type\":\"string\"}],\"description\":\"The category of the disclosure.\"},\"text\":{\"description\":\"The disclosure statement text.\",\"type\":\"string\"},\"type\":{\"allOf\":[{\"enum\":[\"intermediary_role\",\"intermediary_commission\",\"underwriter_disclaimer\",\"anti_selection_notice\",\"statement_of_needs\",\"product_information\",\"pre_existing_conditions\",\"statutory_warning\"],\"type\":\"string\"}],\"description\":\"The specific type of disclosure within its category.\"}},\"required\":[\"category\",\"text\",\"type\"],\"type\":\"object\"},\"type\":\"array\"},\"id\":{\"description\":\"Unique identifier for the policy amendment intent. Prefixed with `pai_`.\",\"example\":\"pai_3b1333d87d9d4fd6ad83ba7f6b0e951a\",\"pattern\":\"pai_.+\",\"type\":\"string\"},\"object\":{\"description\":\"Object type identifier.\",\"readOnly\":true,\"type\":\"string\"},\"pending_confirmation\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"associated_persons\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"dependents\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"dependents_management_intent_id\":{\"description\":\"Unique identifier for the dependents management intent. Prefixed with `dmi_`. Null if not yet created.\",\"example\":\"dmi_3b1333d87d9d4fd6ad83ba7f6b0e951a\",\"pattern\":\"dmi_.+\",\"type\":[\"null\",\"string\"]},\"status\":{\"allOf\":[{\"enum\":[\"action_required\",\"processing\",\"completed\",\"not_undertaken\"],\"type\":\"string\"}],\"description\":\"The status of the dependents management process. Null if not yet started.\",\"type\":\"null\"}},\"type\":\"object\"}],\"description\":\"Dependents-specific information if type is 'dependents'.\",\"type\":\"null\"},\"type\":{\"allOf\":[{\"enum\":[\"dependents\"],\"type\":\"string\"}],\"description\":\"The type of associated person.\"}},\"required\":[\"type\"],\"type\":\"object\"}],\"description\":\"Information about associated persons related to this pending confirmation.\",\"type\":\"null\"},\"code\":{\"allOf\":[{\"enum\":[\"confirm_quote\",\"confirm_opt_out\",\"confirm_qle\"],\"type\":\"string\"}],\"description\":\"The confirmation code indicating what confirmation is pending.\"},\"due_by\":{\"description\":\"The deadline by which the confirmation must be provided.\",\"example\":\"2024-12-01\",\"format\":\"date\",\"type\":\"string\"},\"quote\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"currency\":{\"description\":\"Three-letter currency code (e.g., \\\"EUR\\\", \\\"USD\\\", \\\"GBP\\\") for all monetary amounts in this quote.\",\"type\":\"string\"},\"monthly\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"employee_contribution\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"gross\":{\"description\":\"Gross amount (net + tax).\",\"example\":123.45,\"format\":\"double\",\"type\":\"number\"},\"net\":{\"description\":\"Net amount before tax.\",\"example\":123.45,\"format\":\"double\",\"type\":\"number\"},\"tax\":{\"description\":\"Tax amount.\",\"example\":123.45,\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"gross\",\"net\",\"tax\"],\"type\":\"object\"}],\"description\":\"Employee contribution amounts.\"},\"employer_contribution\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"gross\":{\"description\":\"Gross amount (net + tax).\",\"example\":123.45,\"format\":\"double\",\"type\":\"number\"},\"net\":{\"description\":\"Net amount before tax.\",\"example\":123.45,\"format\":\"double\",\"type\":\"number\"},\"tax\":{\"description\":\"Tax amount.\",\"example\":123.45,\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"gross\",\"net\",\"tax\"],\"type\":\"object\"}],\"description\":\"Employer contribution amounts.\"},\"total\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"gross\":{\"description\":\"Gross amount (net + tax).\",\"example\":123.45,\"format\":\"double\",\"type\":\"number\"},\"net\":{\"description\":\"Net amount before tax.\",\"example\":123.45,\"format\":\"double\",\"type\":\"number\"},\"tax\":{\"description\":\"Tax amount.\",\"example\":123.45,\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"gross\",\"net\",\"tax\"],\"type\":\"object\"}],\"description\":\"Total contribution amounts (sum of employee and employer).\"}},\"required\":[\"employee_contribution\",\"employer_contribution\",\"total\"],\"type\":\"object\"}],\"description\":\"Monthly contribution breakdown for the policy amendment.\"},\"term\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"employee_contribution\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"gross\":{\"description\":\"Gross amount (net + tax).\",\"example\":123.45,\"format\":\"double\",\"type\":\"number\"},\"net\":{\"description\":\"Net amount before tax.\",\"example\":123.45,\"format\":\"double\",\"type\":\"number\"},\"tax\":{\"description\":\"Tax amount.\",\"example\":