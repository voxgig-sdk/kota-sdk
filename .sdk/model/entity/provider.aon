      req: true
      short: "List of countries supported by this provider."
      type: "`$ARRAY`"
    }
    {
      name: "website_url"
      req: true
      short: "The provider's main website URL."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "provider"
