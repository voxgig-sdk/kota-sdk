        "`$ONE`"
        [
          "`$NULL`"
          "`$STRING`"
        ]
      ]
    }
    force_confirmation: {
      h: "Force Confirmation"
      n: "force_confirmation"
      r: true
      sh: "If set to true, the system will always force the `PendingConfirmation` state before enrolling the employee, even if no action is required."
      t: "`$BOOLEAN`"
    }
    group_id: {
      h: "Group Id"
      n: "group_id"
      r: true
      sh: "Identifier for the group associated with this enrolment intent."
