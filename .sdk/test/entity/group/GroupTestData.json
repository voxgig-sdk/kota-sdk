                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "description": {
                      "description": "Short description of the purpose or scope of the `group`.",
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "employer_id": {
                      "description": "Identifier for the `employer` that owns this `group`. Prefixed with `er_`.",
