  "requests": {
    "POST /groups/{group_id}/employees": {
      "provenance": "operation-contract",
      "contract": {
        "operationId": "AddEmployeeToGroup",
        "parameters": [
          {
            "in": "path",
            "name": "group_id",
            "required": true,
            "schema": {
